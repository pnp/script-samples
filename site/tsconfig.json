{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "types": ["node"],
    "erasableSyntaxOnly": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": [".astro/types.d.ts", "src/**/*", "*.ts", "tests/**/*.ts"],
  "exclude": ["dist", "node_modules", "public"]
}
