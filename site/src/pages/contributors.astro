---
import Layout from "../layouts/Layout.astro";
import Recognition from "../components/Recognition.astro";
import { catalog, sitePath } from "../lib/catalog";
---
<Layout title="Contributors" description="Meet the community members sharing real-world scripts for Copilot, Microsoft 365, Power Platform and more.">
  <div class="container page-section">
    <header class="page-heading"><p class="eyebrow">The people behind the scripts</p><h1>Sharing is caring.</h1><p>{catalog.contributors.length} community members. Hundreds of real-world starting points. Meet the people making everyday work a little easier for everyone.</p></header>
    <Recognition />
    <div class="section-heading"><h2>Meet our contributors</h2><a class="text-link" href={sitePath("contributing/")}>Become a contributor &#8594;</a></div>
    <form class="contributor-controls" id="contributor-controls" role="search" aria-label="Find contributors">
      <label class="sr-only" for="contributor-search">Search contributors</label><input id="contributor-search" name="q" type="search" placeholder="Search by name or GitHub handle..." />
      <label class="sr-only" for="contributor-sort">Sort contributors</label><select id="contributor-sort" name="sort"><option value="contributions">Most samples</option><option value="name">Name A-Z</option></select>
    </form>
    <p class="card-description" id="contributor-count" role="status" aria-live="polite">{catalog.contributors.length} contributors</p>
    <div class="contributor-grid" id="contributor-grid">
      {catalog.contributors.map((author) => <article class="contributor-card" data-contributor data-name={author.name} data-handle={author.handle} data-count={author.count}>
        <img class="avatar" src={author.pictureUrl} alt="" width="60" height="60" loading="lazy" decoding="async" data-avatar={author.name} />
        <h2>{author.name}</h2><a class="handle" href={`https://github.com/${author.handle}`}>@{author.handle} &#8599;</a>
        <p>{author.count} {author.count === 1 ? "sample shared" : "samples shared"}</p>
        <a class="text-link" href={`${sitePath("")}?author=${encodeURIComponent(author.handle.toLowerCase())}`}>Explore samples &#8594;</a>
        <a class="contributor-badge-link" href="https://pnp.github.io/recognitionprogram/" title="Every sample contributor is eligible; opt in to claim your badge"><img src={sitePath("assets/credly-badge.png")} alt="" width="32" height="32" loading="lazy" decoding="async" /><span>Contributor badge &#8599;</span></a>
      </article>)}
    </div>
    <div class="empty-state" id="contributor-empty" hidden><h2>No contributors found</h2><p>Try another name or GitHub handle.</p><button class="button button-secondary" type="button" id="reset-contributors">Clear search</button></div>
  </div>
</Layout>
<script>
  const search = document.querySelector<HTMLInputElement>("#contributor-search");
  const sort = document.querySelector<HTMLSelectElement>("#contributor-sort");
  const grid = document.querySelector<HTMLElement>("#contributor-grid");
  const count = document.querySelector<HTMLElement>("#contributor-count");
  const empty = document.querySelector<HTMLElement>("#contributor-empty");
  const form = document.querySelector<HTMLFormElement>("#contributor-controls");
  if (!search || !sort || !grid || !count || !empty || !form) throw new Error("Contributor filters are missing required controls.");
  const controls = { search, sort, grid, count, empty };
  const cards = [...grid.querySelectorAll<HTMLElement>("[data-contributor]")];
  const query = new URLSearchParams(location.search);
  search.value = query.get("q") ?? "";
  sort.value = query.get("sort") === "name" ? "name" : "contributions";
  function apply() {
    const term = controls.search.value.trim().toLowerCase();
    const matches = cards.filter((card) => `${card.dataset.name} ${card.dataset.handle}`.toLowerCase().includes(term));
    matches.sort((a, b) => controls.sort.value === "name"
      ? (a.dataset.name ?? "").localeCompare(b.dataset.name ?? "")
      : Number(b.dataset.count) - Number(a.dataset.count) || (a.dataset.name ?? "").localeCompare(b.dataset.name ?? ""));
    cards.forEach((card) => { card.hidden = true; });
    matches.forEach((card) => { card.hidden = false; controls.grid.append(card); });
    controls.count.textContent = `${matches.length} ${matches.length === 1 ? "contributor" : "contributors"}`;
    controls.empty.hidden = matches.length > 0;
    const next = new URLSearchParams();
    if (controls.search.value.trim()) next.set("q", controls.search.value.trim());
    if (controls.sort.value === "name") next.set("sort", "name");
    history.replaceState(null, "", `${location.pathname}${next.size ? `?${next}` : ""}`);
  }
  form.addEventListener("submit", (event) => event.preventDefault());
  search.addEventListener("input", apply);
  sort.addEventListener("change", apply);
  document.querySelector("#reset-contributors")?.addEventListener("click", () => { controls.search.value = ""; apply(); controls.search.focus(); });
  apply();
</script>
